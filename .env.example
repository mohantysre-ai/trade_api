# docker-compose variable substitution
# Only SIGQ_BIND_ADDRESS is consumed by compose; everything else is
# inlined per-service in docker-compose.yml.
SIGQ_BIND_ADDRESS=127.0.0.1

# Backend application credentials and tunables live in backend/.env.example
# (copy to backend/.env and fill in Angel One / LLM / Shoonya secrets).

# Frontend runtime variables are set inline in docker-compose.yml under the
# frontend service; NEXT_PUBLIC_* values are inlined at build time.
