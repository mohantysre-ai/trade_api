# Required Angel One market-data credentials
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_MPIN=
ANGEL_TOTP_SECRET=

# Optional LLM routing. Leave unused providers blank.
LLM_PROVIDER=
LLM_API_KEY=
LLM_API_URL=
LLM_MODEL=
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
OMNIROUTE_API_KEY=
TINYFISH_API_KEY=

# Optional authenticated Dhan chart API (public ScanX option backup needs none)
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Optional SIGQ OI enrichment session
SIGQ_OI_ENRICHMENT_COOKIE=

# Intraday WebSocket live state
INTRADAY_WS_ENABLED=1
INTRADAY_WS_FRESH_SECONDS=8
INTRADAY_WS_STALE_SECONDS=30
INTRADAY_WS_RECOVERY_SECONDS=60
INTRADAY_RECOVERY_INTERVAL_SEC=60
INTRADAY_RECOVERY_BATCH=25

# Shoonya (Finvasia) hot-standby market-data lane. Off by default — every
# read path behaves exactly as today until this is turned on. Requires a
# separate shoonya-gateway/ service running on a static-IPv4 host; see
# SHOONYA_STANDBY_PROVIDER_SPEC.md before enabling. Do NOT set to 1 before
# the Phase 0 spike (U1-U10 in the spec) has been run against a real account.
SHOONYA_STANDBY_ENABLED=0
SHOONYA_STANDBY_MODE=shadow
SHOONYA_GATEWAY_URL=
SHOONYA_GATEWAY_TOKEN=
SHOONYA_STANDBY_POLL_INTERVAL_SECONDS=2
SHOONYA_STANDBY_PIN_TTL_SECONDS=600
STANDBY_PROMOTE_AFTER_SECONDS=8
STANDBY_BAND_PCT=25
STANDBY_HANDOFF_MAX_DIVERGENCE_PCT=1.0
STANDBY_DIVERGENCE_ALERT_PCT=0.3
STANDBY_DIVERGENCE_MIN_SYMBOLS=3
SHOONYA_CANDLES_ENABLED=0

# Runtime defaults
LOG_LEVEL=INFO
INDEX_OPTIONS_STREAM_ENABLED=1
