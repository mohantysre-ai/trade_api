# Required Angel One market-data credentials
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_MPIN=
ANGEL_TOTP_SECRET=

# Optional LLM routing. Leave unused providers blank.
LLM_PROVIDER=
LLM_API_KEY=
LLM_API_URL=
LLM_MODEL=
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
OMNIROUTE_API_KEY=
TINYFISH_API_KEY=

# Optional authenticated Dhan chart API (public ScanX option backup needs none)
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Optional SIGQ OI enrichment session
SIGQ_OI_ENRICHMENT_COOKIE=

# Runtime defaults
LOG_LEVEL=INFO
INDEX_OPTIONS_STREAM_ENABLED=1
SWING_STRATEGY_AUTHORITY=V2
SWING_V1_ENABLED=0
SWING_V2_ENABLED=true
SWING_V2_MODE=PAPER
SWING_STRATEGY_ID=SWING_2S_MOMENTUM_V2
SWING_UNIVERSE=NIFTY_TOTAL_MARKET_750
SWING_ACTIVE_SEGMENTS=NIFTY100,NIFTY_MIDCAP150,NIFTY_SMALLCAP250
SWING_MICROCAP_MODE=SHADOW
SWING_MAX_POSITIONS=5
SWING_MAX_OVERNIGHTS=2
SWING_DECISION_START_IST=14:30
SWING_DECISION_FREEZE_IST=15:10
SWING_ORDER_EXPIRE_IST=15:20
SWING_MANDATORY_EXIT_IST=15:15
SWING_REQUIRED_UNIVERSE_COVERAGE=0.99
SWING_CORE_RISK_BPS=25
SWING_MICROCAP_RISK_BPS=15
SWING_MAX_PORTFOLIO_RISK_BPS=100
SWING_MAX_NAME_NOTIONAL_PCT=20
SWING_MAX_SECTOR_NOTIONAL_PCT=40
SWING_STOP_ATR_MULT=0.80
SWING_MIN_STOP_PCT=0.75
SWING_MAX_STOP_CORE_PCT=2.25
SWING_MAX_STOP_SMALL_PCT=2.50
SWING_T1_R=1.00
SWING_T1_QTY_PCT=50
SWING_TRAIL_ARM_R=1.50
SWING_TRAIL_LOCK_R=0.75
SWING_T2_R=2.00
SWING_MIN_UPSIDE_CAPACITY_R=1.50
SWING_MIN_EXPECTED_NET_R=0.12
SWING_LIVE_PROMOTION=false
SWING_V2_SESSION_FILE=/app/state/swing_v2_session.json
SWING_V2_LEDGER_PATH=/app/backend/app/data/swing_v2_ledger.sqlite3
