# Copy to .env (0600) on the whitelisted host. Never commit real values.
SHOONYA_UID=
SHOONYA_ACCOUNT_ID=
SHOONYA_CLIENT_ID=
SHOONYA_SECRET_CODE=
SHOONYA_OAUTH_URL=https://api.shoonya.com/OAuthlogin/authorize/oauth
SHOONYA_OAUTH_LOGIN_URL=https://api.shoonya.com/OAuthlogin/investor-entry-level/login
SHOONYA_AUTH_CODE=
SHOONYA_PASSWORD=
SHOONYA_TOTP_SECRET=
SHOONYA_AUTH_MODE=oauth_auto
SHOONYA_OAUTH_BROWSER_TIMEOUT_SECONDS=90
SHOONYA_LOGIN_HHMM=08:15
SHOONYA_LOGIN_DEADLINE_HHMM=08:50
SHOONYA_SESSION_FILE=/data/session.json
SHOONYA_GATEWAY_TOKEN=
SHOONYA_ADMIN_TOKEN=
SHOONYA_WS_MAX_TOKENS=450
SHOONYA_WS_INDEX_RESERVE=20
SHOONYA_INDEX_KEYS=NSE|26000,NSE|26009
SHOONYA_CANDLE_MAX_PER_MIN=60
SHOONYA_REST_RPS=2
SHOONYA_FT_MODE=epoch_utc
SHOONYA_FT_IS_HEARTBEAT=0
SHOONYA_TRUST_C_AS_PREV_CLOSE=0
